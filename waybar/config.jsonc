{
  "layer": "top",
  "position": "top",
  "height": 34,

  "modules-left": ["hyprland/workspaces", "wlr/taskbar"],
  "modules-center": ["mpris"],
  "modules-right": ["pulseaudio", "bluetooth", "battery", "tray", "clock", "custom/power"],

  // --- Right Side Modules ---

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "  MUTED", // Carbon Gray 50 look
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "bluetooth": {
    "format": " ON",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    "format-disabled": " OFF",
    "on-click": "blueman-manager"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "{status_icon} <i>{title} - {artist}</i>",
    "player-icons": {
      "default": "▶",
      "spotify": "",
      "firefox": "",
      "chrome": ""
    },
    "status-icons": {
      "paused": "⏸"
    },
    "title-len": 30, // Keeps it from getting too long
    "artist-len": 20,
    "on-click": "playerctl play-pause"
  },
}
